{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssetRegisterSchema",
  "type": "object",
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "sourcePath", "source", "rightsCleared", "usedOnPages"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["photograph", "logo", "certificate-scan", "icon", "ai-generated", "vector-svg"]
          },
          "sourcePath": { "type": "string" },
          "source": {
            "type": "string",
            "enum": ["company-supplied", "official-website", "ai-generated", "stock-licensed", "official-scan"]
          },
          "rightsCleared": { "type": "boolean" },
          "usedOnPages": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
