{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CompanyDataSchema",
  "type": "object",
  "required": [
    "company",
    "identity",
    "leadership",
    "capabilities",
    "equipment",
    "quality",
    "safety",
    "supplyChain",
    "esg",
    "contact"
  ],
  "properties": {
    "company": {
      "type": "object",
      "required": ["legalName", "constitution", "proprietor", "registrationNo", "classification", "validityUpto", "gstin", "pan"],
      "properties": {
        "legalName": { "type": "string" },
        "constitution": { "type": "string" },
        "proprietor": { "type": "string" },
        "fatherName": { "type": "string" },
        "registrationNo": { "type": "string" },
        "classification": { "type": "string" },
        "validityUpto": { "type": "string" },
        "gstin": { "type": "string" },
        "pan": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "required": ["headquarters", "branchOffice", "verificationPortal"],
      "properties": {
        "headquarters": { "type": "string" },
        "branchOffice": { "type": "string" },
        "verificationPortal": { "type": "string" }
      }
    },
    "leadership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "title", "experience", "role"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "experience": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "ownership"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "ownership": {
            "type": "string",
            "enum": ["owned", "hired", "partner"]
          }
        }
      }
    },
    "quality": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supplyChain": {
      "type": "array",
      "items": { "type": "string" }
    },
    "esg": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contact": {
      "type": "object",
      "required": ["phones", "email", "website"],
      "properties": {
        "phones": {
          "type": "array",
          "items": { "type": "string" }
        },
        "email": { "type": "string" },
        "website": { "type": "string" }
      }
    }
  }
}
